  {
   "n": 1,
   "class": "ctrl",
   "title": "Auto-reset / auto-boot",
   "text": "The programmer drives RESET and BOOT itself: esptool, Arduino IDE and ESP-IDF flash with no button presses. By hand: hold BOOT, tap RESET, release BOOT."
  },
  {
   "n": 2,
   "class": "ctrl",
   "title": "Jumpers JP1 / JP2",
   "text": "Cap fitted = pull-up ON (to the isolated 3V3). JP1 = RESET (EN), JP2 = BOOT (IO0). Ships with the caps removed. Fit them for a bare module powered from the programmer."
  },
  {
   "n": 3,
   "class": "power",
   "title": "Isolation",
   "text": "PC side and target side are galvanically isolated (data and power), rated 1500 VDC. Keep the target's GND separate from the PC's GND."
  },
  {
   "n": 4,
   "class": "uart",
   "title": "Voltage and wiring",
   "text": "3.3 V logic. The isolated 3V3 pin can power the ESP (up to about 150 mA). Cross TX/RX: programmer TX to ESP RX. Always connect GND."
  }
