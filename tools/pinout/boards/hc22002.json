  {
   "n": 1,
   "class": "ctrl",
   "title": "Auto-reset / auto-boot",
   "text": "The programmer drives RESET and BOOT itself: esptool, Arduino IDE and ESP-IDF flash with no button presses. By hand: hold BOOT, tap RESET, release BOOT."
  },
  {
   "n": 2,
   "class": "ctrl",
   "title": "Jumpers JP1 / JP2",
   "text": "Cap fitted = pull-up ON. JP1 pulls RESET (EN) high, JP2 pulls BOOT (IO0) high. Ships with both caps fitted. Remove them if the target has its own pull-ups and flashing is flaky."
  },
  {
   "n": 3,
   "class": "power",
   "title": "Voltage",
   "text": "Logic level 3.3 V. The 3V3 pin can power the ESP (up to about 150 mA). Leave it open if the ESP has its own supply."
  },
  {
   "n": 4,
   "class": "uart",
   "title": "Wiring",
   "text": "Cross the serial lines: programmer TX to ESP RX, programmer RX to ESP TX. Always connect GND."
  }
 ],
